# Скопируйте в .env и заполните своими значениями

# ── Telegram ──────────────────────────────────────────────────
BOT_TOKEN=123456789:AAE-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALLOWED_IDS=123456789            # ваш chat_id, несколько — через запятую

# ── YouTube ───────────────────────────────────────────────────
PRIVACY=unlisted                 # private | unlisted | public
DEFAULT_TAGS=shorts,автопостинг  # теги для каждого ролика
MAX_SECONDS=58                   # бот обрежет всё, что длиннее

# ── AI-режим ──────────────────────────────────────────────────
# Выберите провайдера LLM и получите бесплатный API ключ:
#
# РЕКОМЕНДУЕМЫЕ (без региональных блокировок):
# - Gemini (бесплатный, работает везде): https://aistudio.google.com/app/apikey
# - DeepSeek (бесплатный, работает в большинстве регионов): https://platform.deepseek.com/
# - OpenRouter (проксирует через свои серверы): https://openrouter.ai/keys
#
# ЕСЛИ ЕСТЬ РЕГИОНАЛЬНЫЕ ОГРАНИЧЕНИЯ (Groq заблокирован):
# - Используйте Gemini, DeepSeek или OpenRouter
# - Или настройте прокси: LLM_PROXY=http://proxy:port
#
LLM_PROVIDER=gemini              # groq | gemini | openrouter | deepseek | siliconflow
LLM_API_KEY=                     # вставьте ваш API ключ (без пробелов!)
LLM_MODEL=gemini-2.0-flash       # для Gemini; для DeepSeek: deepseek-chat
TTS_VOICE=ru-RU-DmitryNeural     # голос озвучки (edge-tts)
SCENE_COUNT=5                    # количество сцен в ролике (3-7)

# Прокси для обхода региональных ограничений (опционально)
# Формат: http://user:pass@proxy:port или socks5://proxy:port
# LLM_PROXY=http://127.0.0.1:7890
